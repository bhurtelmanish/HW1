digraph G {
rankdir=TB; graph [bgcolor="white"]; node [shape=box, style="rounded,filled", fillcolor="#edf5ff", fontname="DejaVu Sans"]; edge [color="#49647c"];
n0 [label="Receive stations, count, name"];
n1 [label="Loop over station entries"];
n0 -> n1;
n2 [label="Does name match exactly?"];
n1 -> n2;
n3 [label="If yes, return pointer to first match"];
n2 -> n3;
n4 [label="After loop, return nullptr"];
n3 -> n4;
}