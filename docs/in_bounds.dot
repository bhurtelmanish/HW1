digraph G {
rankdir=TB; graph [bgcolor="white"]; node [shape=box, style="rounded,filled", fillcolor="#edf5ff", fontname="DejaVu Sans"]; edge [color="#49647c"];
n0 [label="Receive row, col, rows, cols"];
n1 [label="Check 0 ≤ row < rows and 0 ≤ col < cols"];
n0 -> n1;
n2 [label="Return comparison result"];
n1 -> n2;
}